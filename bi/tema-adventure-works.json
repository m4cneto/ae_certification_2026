{
  "name": "Adventure Works Comercial",
  "dataColors": ["#2E3FB8", "#9A5B00", "#0F766E", "#7C8DE6", "#D9A441", "#5EAAA1", "#5B6474", "#B8C0F2"],
  "foreground": "#1B1F27",
  "foregroundNeutralSecondary": "#5B6474",
  "foregroundNeutralTertiary": "#98A2B3",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F4F6",
  "backgroundNeutral": "#E4E7EC",
  "tableAccent": "#2E3FB8",
  "good": "#0F766E",
  "bad": "#B42318",
  "neutral": "#9A5B00",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1B1F27" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#1B1F27" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5B6474" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1B1F27" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F4F6" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E7EC" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    }
  }
}
