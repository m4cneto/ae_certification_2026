        <mxCell id="e7" value="sales_order_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#9a5b00;dashed=1;fontSize=10;" edge="1" parent="1" source="bridge" target="fct"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#9a5b00;" edge="1" parent="1" source="dimReason" target="bridge"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="nota" value="&lt;b&gt;Por que a bridge existe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Um pedido pode ter vários motivos de venda. Ligar o motivo direto ao fato multiplicaria cada item pelo número de motivos e inflaria a receita. A bridge isola esse relacionamento. A pergunta &quot;f&quot; do enunciado é respondida pela flag is_promotion, dentro do próprio fato.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fbeedb;strokeColor=#9a5b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="420" height="130" as="geometry" />
        </mxCell>

        <mxCell id="nota2" value="&lt;b&gt;Por que o grão é o item do pedido&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;É o nível mais fino disponível e atende todas as seis perguntas. Em contrapartida, os valores de cabeçalho (frete, imposto, subtotal) ficaram fora do fato: eles se repetem em cada item e qualquer soma ficaria inflada. Número de pedidos é sempre COUNT(DISTINCT sales_order_id).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e6e9fb;strokeColor=#2e3fb8;" vertex="1" parent="1">
          <mxGeometry x="500" y="900" width="430" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
